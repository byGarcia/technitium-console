    "ademas": "DOS tablas dentro: `Member Of` (columna `Group`, pie `Total Groups: N`) y `Active Sessions` (columnas `Session`, `Last Seen`, `Remote Address`, `User Agent`, pie `Total Sessions: N`), con la sesión actual marcada `(current)`."
   },
   "Change Password": {
    "campos": [
     "Current Password",
     "New Password",
     "Confirm Password"
    ],
    "pie": [
     "Save",
     "Close"
    ]
   },
